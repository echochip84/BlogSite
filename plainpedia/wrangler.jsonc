{
  "name": "plainpedia",
  "compatibility_date": "2026-07-05",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 기본 동작은 요청 경로가 정적 자산·_redirects 규칙에 매치되면 Worker의 fetch()를
    // 아예 거치지 않고 바로 서빙한다. src/index.js의 www→apex 리다이렉트는 fetch()
    // 안에만 있어서, homesense-note처럼 이 프로젝트가 직접 서빙하는 블로그의 페이지는
    // 전부 정적 자산으로 매치돼 리다이렉트가 통째로 무시되고 있었다(실측:
    // www.plainpedia.com/homesense/가 301 없이 200으로 열림). tidylab·homecraft처럼
    // 별도 프로젝트로 분리돼 이 프로젝트엔 자산이 없는 블로그만 정상적으로 fetch()로
    // 넘어가 리다이렉트가 걸렸다. run_worker_first로 모든 요청이 반드시 fetch()를
    // 먼저 거치게 해 이 우회를 막는다.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "plainpedia.com", "custom_domain": true },
    { "pattern": "www.plainpedia.com", "custom_domain": true }
  ],
  // 방문자 카운터(src/index.js의 /api/hits). 블로그 하나당 인스턴스 하나이며,
  // 모든 블로그가 이 우산 프로젝트의 엔드포인트 하나를 공유한다.
  "durable_objects": {
    "bindings": [{ "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" }]
  },
  // 무료 플랜에서는 SQLite 백엔드 Durable Object만 사용할 수 있다.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorCounter"] }]
}
